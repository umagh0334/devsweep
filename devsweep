      extra="사용 불가(Unusable/Unknown) 상태의 런타임만 삭제합니다. 현재 쓰는 런타임은 보존."
      if command -v xcrun >/dev/null 2>&1; then method="native"; command="xcrun simctl runtime delete <사용불가 런타임>"
      else method="rm"; command="(Xcode 명령줄 도구 없음)"; native_avail="false"; fi ;;
  esac

  # ── 안전성 (SAFE/HEAVY 소속 기반) ──
  local safety safety_note
  if is_in "$cat" "${HEAVY_CATS[@]}"; then
    safety="caution"; safety_note="재설치/재다운로드 비용이 큼. 자주 안 쓰면 정리해도 됨."
  else
    safety="safe"; safety_note="순수 캐시라 소스·프로젝트엔 영향 없음."
  fi

  # ── 경로별 측정 + JSON 배열 조립 (없는 경로/권한오류 방어) ──
  local paths_json="[" first=1 p kb ex rd disp needs_tcc="false"
  while IFS= read -r p; do
    [ -z "$p" ] && continue
    # 나이 필터(AGE_DAYS) 반영: paths_size_kb 가 --older-than 시 mtime 기준만 합산 →
    # path별 용량 합과 헤더 size_kb(do_<cat> size) 가 같은 기준으로 일치.
    if [ -e "$p" ]; then ex="true"; kb=$(paths_size_kb "$p")
    else ex="false"; kb=0; fi
    kb=${kb:-0}
    if [ -r "$p" ]; then rd="true"; else rd="false"; fi
    case "$p" in
      "$HOME/Library/Caches/"*|"$HOME/Library/Developer/"*|"$HOME/Library/Application Support/"*) needs_tcc="true" ;;
    esac
    disp=$(printf '%s' "$p" | sed "s|^${HOME}|~|")
    [ "$first" -eq 0 ] && paths_json+=","
    first=0
    paths_json+=$(printf '{"path":"%s","size_kb":%s,"exists":%s,"readable":%s}' "$(json_escape "$disp")" "$kb" "$ex" "$rd")
  done < <("do_$cat" paths 2>/dev/null)
  paths_json+="]"

  # ── 전체 용량 / heavy / fallback ──
  local size_kb heavy fallback_json protected_f
  size_kb=$("do_$cat" size 2>/dev/null); size_kb=${size_kb:-0}
  if is_in "$cat" "${HEAVY_CATS[@]}"; then heavy="true"; else heavy="false"; fi
  if is_protected "$cat"; then protected_f="true"; else protected_f="false"; fi
  if [ "$fallback" = "null" ]; then fallback_json="null"; else fallback_json="\"$(json_escape "$fallback")\""; fi

  printf '{"name":"%s","size_kb":%s,"kind":"%s","heavy":%s,"protected":%s,"safety":"%s","safety_note":"%s","regen_cost":"%s","regen_note":"%s","method":"%s","command":"%s","fallback":%s,"native_available":%s,"needs_tcc":%s,"extra":"%s","paths":%s}\n' \
    "$cat" "$size_kb" "$(json_escape "$kind")" "$heavy" "$protected_f" \
    "$safety" "$(json_escape "$safety_note")" \
    "$regen_cost" "$(json_escape "$regen_note")" \
    "$method" "$(json_escape "$command")" "$fallback_json" "$native_avail" "$needs_tcc" \
    "$(json_escape "$extra")" "$paths_json"
}

cmd_clean() {
  local apply=0 force=0 explicit=0 args=() targets=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes|-y) apply=1 ;;
      --force|-f) force=1 ;;
      *) args+=("$1") ;;
    esac
    shift
  done
  # 나이 필터(--older-than)는 전역에서 AGE_DAYS 로 파싱됨

  # 대상 카테고리 결정
  if [ "${#args[@]}" -eq 0 ] || is_in "all" "${args[@]:-}"; then
    targets=("${SAFE_CATS[@]}")
    is_in "all" "${args[@]:-}" && targets+=("${HEAVY_CATS[@]}")
  else
    explicit=1
    for a in "${args[@]}"; do
      if is_in "$a" "${SAFE_CATS[@]}" "${HEAVY_CATS[@]}"; then targets+=("$a")
      else echo "${C_Y}경고: 알 수 없는 카테고리 '$a' (무시)${C_0}" >&2; fi
    done
  fi
  [ "${#targets[@]}" -eq 0 ] && { echo "정리할 대상 없음."; return 0; }

  # 보호 목록 필터: 자동(clean/all)은 조용히 제외, 명시 지정은 경고 후 차단(--force 우회)
  if [ "${#PROTECTED[@]}" -gt 0 ]; then
    local kept=() t
    for t in "${targets[@]}"; do
      if is_protected "$t"; then
        if [ "$explicit" -eq 1 ] && [ "$force" -eq 1 ]; then kept+=("$t")
        elif [ "$explicit" -eq 1 ]; then echo "${C_Y}보호됨: '$t' 는 보호 목록이라 건너뜀 (--force 로 우회)${C_0}" >&2; fi
        # 자동(clean/all)이면 조용히 제외
      else kept+=("$t"); fi
    done
    [ "${#kept[@]}" -eq 0 ] && { echo "정리할 대상 없음 (전부 보호됨)."; return 0; }
    targets=("${kept[@]}")
  fi

  local c
  if [ "$apply" -eq 0 ]; then
    echo "${C_B}정리 미리보기${C_0} ${C_DIM}(dry-run — 실제 삭제 안 함)${C_0}"
    [ -n "$AGE_DAYS" ] && echo "${C_DIM}나이 필터: ${AGE_DAYS}일보다 오래된 파일만 (docker 등 경로 없는 항목 제외)${C_0}"
    echo "────────────────────────────────────────────"
    local total=0 kb
    for c in "${targets[@]}"; do "do_$c" dry; kb=$("do_$c" size); total=$((total + ${kb:-0})); done
    echo "────────────────────────────────────────────"
    printf "  %-16s ${C_B}%6s${C_0}\n" "추정 회수가능" "$(human "$total")"
    echo
    echo "${C_G}실제로 지우려면 --yes 추가:${C_0}  devsweep clean --yes ${args[*]:-}"
  else
    echo "${C_B}정리 실행${C_0}"
    [ -n "$AGE_DAYS" ] && echo "${C_DIM}나이 필터: ${AGE_DAYS}일보다 오래된 파일만 (docker 등 제외)${C_0}"
    local c p fails=0
    for c in "${targets[@]}"; do
      printf "  %-16s ... " "$c"
      if [ -n "$AGE_DAYS" ]; then
        if is_in "$c" "${NO_AGE_CATS[@]}"; then echo "${C_DIM}나이 필터 미지원(건너뜀)${C_0}"; continue; fi
        # 나이 필터: 경로를 직접 mtime 기준 삭제 (wipe 가 AGE_DAYS 참조 → 네이티브 전체삭제 명령 우회)
        local age_rc=0
        while IFS= read -r p; do [ -n "$p" ] && { wipe "$p" || age_rc=1; }; done < <("do_$c" paths 2>/dev/null)
        if [ "$age_rc" -eq 0 ]; then echo "${C_G}완료${C_0}"; else echo "${C_R}실패${C_0}"; fails=$((fails + 1)); fi
      else
        if "do_$c" clean; then echo "${C_G}완료${C_0}"; else echo "${C_R}실패${C_0}"; fails=$((fails + 1)); fi
      fi
    done
    # 부분 실패라도 비0 종료 — GUI(Engine)가 exit≠0 에만 throw 하므로, 거짓 회수량 누적/알림을 막는다.
    if [ "$fails" -gt 0 ]; then echo "${C_Y}${fails}개 항목 정리 실패 (권한 등 — 위 '실패' 표시 참고)${C_0}" >&2; return 1; fi
  fi
}

# 자동 정리가 비울 추정 용량(KB)만 출력 — clean(인자 없음)과 동일 타겟(SAFE·보호제외·나이반영).
# 기계가독 숫자만. headless 래퍼가 before/after 로 실제 회수량 산출하는 데 사용(python3 등 외부 의존 0).
cmd_total() {
  local t total=0 kb
  for t in "${SAFE_CATS[@]}"; do
    is_protected "$t" && continue
    if [ -n "$AGE_DAYS" ] && is_in "$t" "${NO_AGE_CATS[@]}"; then continue; fi
    kb=$("do_$t" size 2>/dev/null); total=$((total + ${kb:-0}))
  done
  echo "$total"
}

# 카테고리의 삭제 대상 경로를 한 줄에 하나씩 출력 (GUI 휴지통 모드용).
# 명령 기반(docker·rustup-targets 등 paths 액션 없는)은 빈 출력 → GUI 가 네이티브 clean 으로 폴백.
cmd_paths() {
  local c
  for c in "$@"; do
    is_in "$c" "${SAFE_CATS[@]}" "${HEAVY_CATS[@]}" || continue
    "do_$c" paths 2>/dev/null
  done
}

# TCC 보호 폴더(데스크탑·문서·다운로드) prune 인자 계산 — 기본 스캔에서 제외해 macOS 권한 팝업 방지.
#   --include-protected 시 빈 배열(전부 스캔). root 가 보호 폴더 안/자체면 그 폴더는 제외 안 함
#   (사용자가 직접 지정한 의도 — NSOpenPanel 선택은 macOS 도 팝업 없이 허용).
PROT_PRUNE=()
set_prot_prune() {
  local root="$1" d
  PROT_PRUNE=()
  # 미디어 폴더(음악·사진·동영상)는 **항상** 제외 — 라이브러리 번들에 닿는 순간 Apple Music/사진
  # TCC 팝업이 뜨고(ad-hoc 은 빌드마다 재요청), 개발 산출물이 있을 일도 없다. root 직접 지정 시만 예외.
  for d in "$HOME/Music" "$HOME/Pictures" "$HOME/Movies"; do
    case "$root" in "$d"|"$d"/*) continue ;; esac
    PROT_PRUNE+=(-o -path "$d")
  done
  [ "${INCLUDE_PROTECTED:-0}" = 1 ] && return 0
  for d in "$HOME/Desktop" "$HOME/Documents" "$HOME/Downloads"; do
    case "$root" in "$d"|"$d"/*) continue ;; esac
    PROT_PRUNE+=(-o -path "$d")
  done
}

# 프로젝트 폴더 스캐너 — root 아래에서 무거운 빌드/의존 폴더(node_modules 등)를 찾아 JSON 출력.
#   각: {"path","size_kb","age_days"}. 찾은 폴더 내부는 -prune 로 재귀 안 함(중첩 중복/과탐색 방지).
#   Library·.Trash·.git 는 스킵. 0KB 는 제외. usage: scan-projects [root]
cmd_scan_projects() {
  local root="${1:-$HOME}"
  root="${root/#\~/$HOME}"
  [ -d "$root" ] || { printf '[]\n'; return 0; }
  local now first=1 d kb mt days
  now=$(date +%s)
  printf '['
  while IFS= read -r d; do
    [ -n "$d" ] || continue
    kb=$(du -sk "$d" 2>/dev/null | awk '{print $1}'); kb=${kb:-0}
    [ "$kb" -eq 0 ] && continue
    mt=$(stat -f %m "$d" 2>/dev/null || echo "$now")
    days=$(( (now - mt) / 86400 )); [ "$days" -lt 0 ] && days=0
    [ "$first" -eq 1 ] && first=0 || printf ','
    printf '{"path":"%s","size_kb":%s,"age_days":%s}' "$(json_escape "$d")" "$kb" "$days"
  done < <(set_prot_prune "$root"; find "$root" \
      \( -path '*/Library/*' -o -path '*/.Trash/*' -o -path '*/.git/*' \
         ${PROT_PRUNE[@]+"${PROT_PRUNE[@]}"} \) -prune -o \
      -type d \( -name node_modules -o -name target -o -name .next -o -name .nuxt \
                 -o -name dist -o -name build -o -name Pods -o -name .venv -o -name venv \
                 -o -name __pycache__ -o -name .turbo -o -name .parcel-cache \) -prune -print 2>/dev/null)
  printf ']\n'
}

# ── 보안 점검(민감 파일 스캐너) ───────────────────────────────
# 파일명(+전체경로)으로 민감 종류를 판정. 제외/미분류면 비0 반환. 출력: env|key|cred|state
#   .env.example 류·공개키(.pub)는 위험이 아니므로 제외. credentials 는 ~/.aws 아래만.
secret_kind() {
  local b="$1" full="$2"
  case "$b" in
    .env.example|.env.sample|.env.template|.env.dist|.env.*.example|.env.*.sample) return 1 ;;
    .env|.env.*)                          echo env ;;
    id_rsa|id_dsa|id_ecdsa|id_ed25519)    echo key ;;
    *.pem|*.key|*.p12|*.pfx|*.keystore|*.jks) echo key ;;
    .npmrc|.pypirc|.netrc|.git-credentials)   echo cred ;;
    credentials) case "$full" in */.aws/credentials) echo cred ;; *) return 1 ;; esac ;;
    .pgpass|.my.cnf)                      echo cred ;;                     # DB 접속 비밀번호
    AuthKey_*.p8)                         echo key ;;                      # Apple 푸시/API 키
    service-account*.json|serviceAccount*.json) echo cred ;;               # GCP 서비스 계정
    application_default_credentials.json) echo cred ;;                     # gcloud ADC
    hosts.yml)   case "$full" in */.config/gh/hosts.yml)  echo cred ;; *) return 1 ;; esac ;;  # gh OAuth 토큰
    config.json) case "$full" in */.docker/config.json)   echo cred ;; *) return 1 ;; esac ;;  # 레지스트리 인증
    config)      case "$full" in */.kube/config)          echo cred ;; *) return 1 ;; esac ;;  # 클러스터 토큰
    credentials.db|access_tokens.db) case "$full" in */gcloud/*) echo cred ;; *) return 1 ;; esac ;;
    *.tfstate|*.tfstate.backup)           echo state ;;
    *) return 1 ;;
  esac
}

# 파일의 git 노출 상태를 판정한다(내용 안 읽음, 파일명 경로만 git 에 질의).
#   tracked   = 이미 커밋됨 → 히스토리에 노출(최악)
#   untracked = repo 안이지만 gitignore 안 됨 → 다음 `git add .` 에 딸려갈 위험
#   ignored   = gitignore 로 보호됨
#   norepo    = git repo 밖 (또는 git 미설치)
git_leak_state() {
  local f="$1" dir base
  command -v git >/dev/null 2>&1 || { echo norepo; return; }
  dir=$(dirname "$f"); base=$(basename "$f")
  git -C "$dir" rev-parse --show-toplevel >/dev/null 2>&1 || { echo norepo; return; }
  if git -C "$dir" ls-files --error-unmatch -- "$base" >/dev/null 2>&1; then echo tracked; return; fi
  if git -C "$dir" check-ignore -q -- "$base" 2>/dev/null; then echo ignored; return; fi
  echo untracked
}

# 민감 파일 보안 점검 — root 아래에서 .env·개인키·크리덴셜 등을 찾아 위험도와 함께 JSON 출력.
#   각: {"path","name","kind","risk","reason","git","perm"}
#     kind: env|key|cred|state   risk: critical|high|medium|low   git: tracked|untracked|ignored|norepo
#   ⚠️ 파일 내용은 절대 읽지 않는다 — 파일명·git 상태·권한만으로 판정(프라이버시). 삭제도 안 함(리포트 전용).
#   node_modules·vendor·Pods·Library·.Trash·.git 는 스킵. usage: scan-secrets [root]
cmd_scan_secrets() {
  local root="${1:-$HOME}"
  root="${root/#\~/$HOME}"
  [ -d "$root" ] || { printf '[]\n'; return 0; }
  local first=1 f base kind risk reason gitst perm go now mt age
  now=$(date +%s)
  printf '['
  # ~/.ssh 폴더 자체 권한 점검 — 700 아니면(타 유저 접근 가능) medium. 스캔 root 가 폴더를 포함할 때만.
  local sshdir="$HOME/.ssh" dperm dgo
  case "$sshdir" in
    "$root"|"$root"/*)
      if [ -d "$sshdir" ]; then
        dperm=$(stat -f '%OLp' "$sshdir" 2>/dev/null || echo "")
        dgo="${dperm: -2}"
        if [ -n "$dperm" ] && [ "$dgo" != "00" ]; then
          first=0
          printf '{"path":"%s","name":".ssh","kind":"key","risk":"medium","reason":"permdir","git":"norepo","perm":"%s","age_days":0}' \
            "$(json_escape "$sshdir")" "$dperm"
        fi
      fi ;;
  esac
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    base=$(basename "$f")
    kind=$(secret_kind "$base" "$f") || continue     # 제외 대상(.env.example 등)이면 건너뜀
    gitst=$(git_leak_state "$f")
    perm=$(stat -f '%OLp' "$f" 2>/dev/null || echo "")
    mt=$(stat -f %m "$f" 2>/dev/null || echo "$now")
    age=$(( (now - mt) / 86400 )); [ "$age" -lt 0 ] && age=0
    # 위험도: git 노출 상태를 1차 기준으로
    risk=low; reason="info"
    case "$gitst" in
      tracked)   risk=critical; reason="tracked" ;;
      untracked) risk=high;     reason="untracked" ;;
    esac
    # 개인키인데 group/other 접근 가능(권한 느슨) → git 위험이 낮을 때 medium 로 승격
    if [ "$kind" = key ] && [ -n "$perm" ]; then
      go="${perm: -2}"
      if [ "$go" != "00" ] && [ "$risk" = low ]; then risk=medium; reason="perm"; fi
    fi
    # 오래된 키/크리덴셜(180일+) → 로테이션 권장. 다른 위험이 없을 때만(정보성 승격)
    if [ "$risk" = low ] && { [ "$kind" = key ] || [ "$kind" = cred ]; } && [ "$age" -ge 180 ]; then
      risk=medium; reason="stale"
    fi
    [ "$first" -eq 1 ] && first=0 || printf ','
    printf '{"path":"%s","name":"%s","kind":"%s","risk":"%s","reason":"%s","git":"%s","perm":"%s","age_days":%s}' \
      "$(json_escape "$f")" "$(json_escape "$base")" "$kind" "$risk" "$reason" "$gitst" "$perm" "$age"
  done < <(set_prot_prune "$root"; find "$root" \
      \( -path '*/Library/*' -o -path '*/.Trash/*' -o -path '*/.git/*' \
         -o -path '*/node_modules/*' -o -path '*/vendor/*' -o -path '*/Pods/*' \
         ${PROT_PRUNE[@]+"${PROT_PRUNE[@]}"} \) -prune -o \
      -type f \( -name '.env' -o -name '.env.*' \
                 -o -name 'id_rsa' -o -name 'id_dsa' -o -name 'id_ecdsa' -o -name 'id_ed25519' \
                 -o -name '*.pem' -o -name '*.key' -o -name '*.p12' -o -name '*.pfx' \
                 -o -name '*.keystore' -o -name '*.jks' \
                 -o -name '.npmrc' -o -name '.pypirc' -o -name '.netrc' -o -name '.git-credentials' \
                 -o -name 'credentials' -o -name '*.tfstate' -o -name '*.tfstate.backup' \
                 -o -name '.pgpass' -o -name '.my.cnf' -o -name 'AuthKey_*.p8' \
                 -o -name 'service-account*.json' -o -name 'serviceAccount*.json' \
                 -o -name 'application_default_credentials.json' \
                 -o -name 'hosts.yml' -o -name 'config.json' -o -name 'config' \
                 -o -name 'credentials.db' -o -name 'access_tokens.db' \) -print 2>/dev/null)
  printf ']\n'
}

# 파일 1개의 민감도를 판정한다 (실시간 감시가 이벤트마다 호출 — 가볍게 유지).
#   scan-secrets 와 동일한 규칙(secret_kind·git_leak_state·권한·나이)을 재사용하며,
#   민감 파일이 아니면 {"kind":""} 를 돌려준다. 내용은 읽지 않는다.
#   usage: check-secret <path>
cmd_check_secret() {
  local f="${1:-}"
  f="${f/#\~/$HOME}"
  [ -n "$f" ] && [ -e "$f" ] || { printf '{"kind":""}\n'; return 0; }
  local base kind risk reason gitst perm go now mt age
  base=$(basename "$f")
  kind=$(secret_kind "$base" "$f") || { printf '{"kind":""}\n'; return 0; }
  gitst=$(git_leak_state "$f")
  perm=$(stat -f '%OLp' "$f" 2>/dev/null || echo "")
  now=$(date +%s); mt=$(stat -f %m "$f" 2>/dev/null || echo "$now")
  age=$(( (now - mt) / 86400 )); [ "$age" -lt 0 ] && age=0
  risk=low; reason="info"
  case "$gitst" in
    tracked)   risk=critical; reason="tracked" ;;
    untracked) risk=high;     reason="untracked" ;;
  esac
  if [ "$kind" = key ] && [ -n "$perm" ]; then
    go="${perm: -2}"
    if [ "$go" != "00" ] && [ "$risk" = low ]; then risk=medium; reason="perm"; fi
  fi
  if [ "$risk" = low ] && { [ "$kind" = key ] || [ "$kind" = cred ]; } && [ "$age" -ge 180 ]; then
    risk=medium; reason="stale"
  fi
  printf '{"path":"%s","name":"%s","kind":"%s","risk":"%s","reason":"%s","git":"%s","perm":"%s","age_days":%s}\n' \
    "$(json_escape "$f")" "$(json_escape "$base")" "$kind" "$risk" "$reason" "$gitst" "$perm" "$age"
}

# git 히스토리 시크릿 검사 — 외부 도구 gitleaks 에 위임하고 **메타데이터만** 재방출한다.
#   🔴 gitleaks 리포트에는 시크릿 원문(Secret/Match)이 들어있다. 이 함수는 그 두 필드를 절대
#      출력하지 않고(파이프로도 흘리지 않음), 임시 리포트는 파싱 직후 삭제한다 — DevSweep 은
#      시크릿 값을 보유하지 않는다는 계약을 CLI 단계에서 지킨다.
#   출력: {"available":bool,"repos":N,"findings":[{"rule","desc","file","commit","line","author","date","message"}]}
#   usage: scan-git-secrets [root]
cmd_scan_git_secrets() {
  local root="${1:-$HOME}"
  root="${root/#\~/$HOME}"
  if ! command -v gitleaks >/dev/null 2>&1; then
    printf '{"available":false,"repos":0,"findings":[]}\n'; return 0
  fi
  [ -d "$root" ] || { printf '{"available":true,"repos":0,"findings":[]}\n'; return 0; }

  local tmp repos=0 first=1 gitdir repo
  tmp=$(mktemp -t devsweep-gl) || { printf '{"available":true,"repos":0,"findings":[]}\n'; return 0; }
  # 리포트에 시크릿 원문이 담기므로 어떤 경로로 빠져나가도 지워지도록 트랩을 건다
  trap 'rm -f "$tmp"' RETURN

  printf '{"available":true,'
  local body="" part
  while IFS= read -r gitdir; do
    [ -n "$gitdir" ] || continue
    repo=$(dirname "$gitdir")
    repos=$((repos + 1))
    : > "$tmp"
    gitleaks git "$repo" --report-format json --report-path "$tmp" --no-banner >/dev/null 2>&1 || true
    [ -s "$tmp" ] || continue
    # Secret/Match 는 읽지도 내보내지도 않는다 (아래 키만 선택 방출)
    part=$(python3 - "$tmp" "$repo" <<'PY'
import json, sys
try:
    rows = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(0)
repo = sys.argv[2]
out = []
for r in rows if isinstance(rows, list) else []:
    out.append(json.dumps({
        "rule":    r.get("RuleID", ""),
        "desc":    r.get("Description", ""),
        "repo":    repo,
        "file":    r.get("File", ""),
        "commit":  (r.get("Commit") or "")[:8],
        "line":    r.get("StartLine", 0),
        "author":  r.get("Author", ""),
        "date":    (r.get("Date") or "")[:10],
        "message": (r.get("Message") or "").split("\n")[0][:80],
    }, ensure_ascii=False))
print(",".join(out), end="")
PY
)
    # repo 별 조각을 콤마로 이어붙인다 (빈 조각은 건너뜀 — 구분자 꼬임 방지)
    if [ -n "$part" ]; then
      if [ "$first" -eq 1 ]; then first=0; else body+=","; fi
      body+="$part"
    fi
  done < <(find "$root" \
      \( -path '*/Library/*' -o -path '*/.Trash/*' -o -path '*/node_modules/*' \
         -o -path "$HOME/Music" -o -path "$HOME/Pictures" -o -path "$HOME/Movies" \) -prune -o \
      -type d -name .git -print 2>/dev/null)
  rm -f "$tmp"
  printf '"repos":%s,"findings":[%s]}\n' "$repos" "$body"
}

# ── 엔트리포인트 ─────────────────────────────────────────────
# 전역 옵션: --older-than=Nd|Nw|N (모든 명령 공통 — scan/json/detail/clean 의 측정·정리에 적용)
AGE_DAYS=""
set_age() {
  local v="$1" num; num="${v%[dw]}"
  case "$num" in ''|*[!0-9]*) echo "${C_Y}--older-than 값 오류: '$v' (예: 30d, 2w)${C_0}" >&2; exit 1 ;; esac
  case "$v" in *w) AGE_DAYS=$(( num * 7 )) ;; *) AGE_DAYS="$num" ;; esac
}
_args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --older-than)   shift; set_age "${1:-}" ;;
    --older-than=*) set_age "${1#*=}" ;;
    --include-protected) INCLUDE_PROTECTED=1 ;;   # 스캔에 TCC 보호 폴더 포함 (기본 제외)
    *) _args+=("$1") ;;
  esac
  shift
done
set -- "${_args[@]}"

case "${1:-scan}" in
  scan|"")     cmd_scan ;;
  list|ls)     cmd_list ;;
  --json|json) cmd_json ;;
  detail)      shift; cmd_detail "${1:-}" ;;
  clean|c)     shift; cmd_clean "$@" ;;
  total)       cmd_total ;;
  paths)       shift; cmd_paths "$@" ;;
  scan-projects) shift; cmd_scan_projects "${1:-}" ;;
  scan-secrets)  shift; cmd_scan_secrets "${1:-}" ;;
  scan-git-secrets) shift; cmd_scan_git_secrets "${1:-}" ;;
  check-secret)  shift; cmd_check_secret "${1:-}" ;;
  -h|--help|help) awk 'NR>=2 && /^set /{exit} NR>=2{sub(/^# ?/,""); print}' "$0" ;;
  *) echo "알 수 없는 명령: $1  ('devsweep --help' 참고)" >&2; exit 1 ;;
esac
