#!/usr/bin/env bash
#
# devsweep — 개인용 개발 캐시/임시파일 정리 도구
#
#   설계 원칙:
#     1) 화이트리스트 방식 — 지워도 되는 경로/명령만 명시. 모르는 건 안 건드림.
#     2) 기본 dry-run    — 그냥 실행하면 "뭘 얼마나 지울지"만 보여줌. 실제 삭제는 --yes.
#     3) 네이티브 우선   — brew/docker/npm 등은 공식 cleanup 명령을 쓰고, 없으면 rm.
#
#   사용법:
#     devsweep                 현황 스캔 (용량만, 아무것도 안 지움)
#     devsweep list            지원 카테고리 목록
#     devsweep --json          스캔 결과를 JSON으로 출력 (GUI 연동용)
#     devsweep detail <cat>    카테고리 1개 상세 정보를 JSON으로 (GUI 펼침뷰용)
#     devsweep clean           정리 미리보기 (dry-run, 안전 카테고리 전체)
#     devsweep clean --yes     실제 정리 실행
#     devsweep clean gradle npm        특정 카테고리만 미리보기
#     devsweep clean --yes gradle npm  특정 카테고리만 실제 정리
#     devsweep clean --yes all         heavy 포함 전체 정리
#
set -euo pipefail

# ─────────────────────────────────────────────────────────────
#  카테고리 정의
#    SAFE_CATS  : `clean`/`clean all`에 포함되는 기본 안전 카테고리
#    HEAVY_CATS : 재설치/재다운로드 비용이 큰 것 — 이름을 직접 지정해야만 정리
# ─────────────────────────────────────────────────────────────
SAFE_CATS=(gradle npm yarn pnpm bun pip uv cargo go cocoapods swiftpm composer nuget deno brew colima xcode vscode cursor zed codemate electron ccache gem poetry carthage)
# 기본 clean·자동정리(SAFE 전체)에서 제외하고 이름/‘all’ 지정 때만 정리하는 항목:
#   - docker : prune 이 중지 컨테이너/네트워크/빌드캐시까지 지우는 '상태성 큰' 작업
#   - maven  : ~/.m2/repository 에 'mvn install' 한 로컬/사내 SNAPSHOT 이 섞여 재다운로드 불가할 수 있음
#   - pub    : ~/.pub-cache 에 flutter 로컬 패키지 등 원격에 없는 artifact 가 섞일 수 있음
HEAVY_CATS=(docker maven pub playwright rustup-targets xcode-sim huggingface jetbrains androidstudio codex puppeteer cypress ollama lmstudio xcode-devsupport simruntime conda bazel)
# 네이티브 cleanup 명령(또는 prune)으로 정리되는 카테고리 — 나이 필터(--older-than) 미적용
NATIVE_CATS=(npm yarn pnpm pip uv brew docker rustup-targets go nuget xcode-sim conda simruntime)
# 경로가 없어(VM/메타데이터) 나이 필터(--older-than) 측정·정리가 불가능한 카테고리
NO_AGE_CATS=(docker rustup-targets xcode-sim codex simruntime)

# ─────────────────────────────────────────────────────────────
#  보호 목록 (protect list)
#    ~/.config/devsweep/config 의 `protect=cat1,cat2` 라인에 적힌 카테고리는
#    화이트리스트에 있어도 정리/관여하지 않는다. (남겨둬야 하는 캐시 보호용)
#    화이트리스트(지울 것만 명시) 위에 얹는, "특정 카테고리만 영구 dry-run".
# ─────────────────────────────────────────────────────────────
DEVSWEEP_CONFIG="${DEVSWEEP_CONFIG:-$HOME/.config/devsweep/config}"
PROTECTED=()
if [ -f "$DEVSWEEP_CONFIG" ]; then
  while IFS= read -r _line || [ -n "$_line" ]; do
    _line="${_line%%#*}"                       # 주석 제거
    case "$_line" in
      protect=*)
        IFS=',' read -ra _items <<<"${_line#protect=}"
        for _it in "${_items[@]}"; do
          _it="${_it//[[:space:]]/}"           # 공백 제거
          [ -n "$_it" ] && PROTECTED+=("$_it")
        done ;;
    esac
  done < "$DEVSWEEP_CONFIG"
fi

# 색상 (터미널 아닐 땐 비활성)
if [ -t 1 ]; then
  C_DIM=$'\033[2m'; C_B=$'\033[1m'; C_G=$'\033[32m'; C_Y=$'\033[33m'; C_R=$'\033[31m'; C_0=$'\033[0m'
else
  C_DIM=''; C_B=''; C_G=''; C_Y=''; C_R=''; C_0=''
fi

# ── 유틸 ─────────────────────────────────────────────────────

# 경로들의 합산 용량을 KB로 (존재하는 것만)
paths_size_kb() {
  local total=0 kb p
  for p in "$@"; do
    [ -e "$p" ] || continue
    if [ -n "${AGE_DAYS:-}" ]; then
      # 나이 필터: mtime 기준 N일보다 오래된 파일 크기(byte)만 합산 → KB
      local bytes
      bytes=$(find "$p" -type f -mtime +"$AGE_DAYS" -exec stat -f%z {} + 2>/dev/null | awk '{s+=$1} END{print s+0}')
      kb=$(( ${bytes:-0} / 1024 ))
    else
      kb=$(du -sk "$p" 2>/dev/null | awk '{print $1}')
    fi
    total=$((total + ${kb:-0}))
  done
  echo "$total"
}

# KB → 사람이 읽는 단위
human() {
  local kb=${1:-0}
  if   [ "$kb" -ge 1048576 ]; then awk "BEGIN{printf \"%.1fG\", $kb/1048576}"
  elif [ "$kb" -ge 1024 ];    then awk "BEGIN{printf \"%.0fM\", $kb/1024}"
  else echo "${kb}K"; fi
}

# 존재하는 경로만 안전하게 삭제 (빈 변수 방어).
# 계약: 하나라도 실제로 못 지우면 비0 반환 — 호출부(cmd_clean→GUI)가 부분 실패를 성공으로
# 묻지 않게 한다. rm -rf 는 -f 로도 권한 거부 시 비0를 내고, 그래도 0이면 잔존 여부로 재확인.
wipe() {
  local p rc=0
  for p in "$@"; do
    [ -n "$p" ] && [ -e "$p" ] || continue
    if [ -n "${AGE_DAYS:-}" ]; then
      # 나이 필터: mtime 기준 N일보다 오래된 파일만 삭제 후 빈 디렉터리 정리
      find "$p" -type f -mtime +"$AGE_DAYS" -delete 2>/dev/null || true
      find "$p" -mindepth 1 -type d -empty -delete 2>/dev/null || true
    else
      rm -rf -- "$p" || true            # set -e 하에서도 중단 금지 — 실패 판정은 아래 잔존검사로 일원화
      if [ -e "$p" ]; then rc=1; fi      # rm 이 0을 내도 경로가 남으면 실패로 간주(권한 등)
    fi
  done
  return $rc
}

# JSON 객체 한 개 출력 (GUI 연동용). heavy 여부는 HEAVY_CATS 소속으로 판정.
#   usage: emit_json <name> <size_kb> <kind>
emit_json() {
  local heavy=false protected=false
  is_in "$1" "${HEAVY_CATS[@]}" && heavy=true
  is_protected "$1" && protected=true
  printf '{"name":"%s","size_kb":%s,"kind":"%s","heavy":%s,"protected":%s}' "$1" "${2:-0}" "$3" "$heavy" "$protected"
}

# JSON 문자열 값 이스케이프 (역슬래시/큰따옴표). detail 모드의 command/note용.
json_escape() { printf '%s' "${1:-}" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

# ── 카테고리별 핸들러: do_<cat> <action>  (action = size|dry|clean) ──
#   size  : KB 숫자만 출력
#   dry   : 사람이 읽을 미리보기 한 줄
#   clean : 실제 정리 수행

# 경로 기반 카테고리를 위한 공통 처리기
#   usage: handle_paths <action> <라벨> <유형> -- path...
handle_paths() {
  local action="$1" label="$2" kind="$3"; shift 4   # 4번째 "--" 버림
  case "$action" in
    size) paths_size_kb "$@" ;;
    dry)  printf "  %-16s %6s  ${C_DIM}%s${C_0}\n" "$label" "$(human "$(paths_size_kb "$@")")" "$kind" ;;
    json) emit_json "$label" "$(paths_size_kb "$@")" "$kind" ;;
    paths) printf '%s\n' "$@" ;;
    clean) wipe "$@" ;;
  esac
}

do_gradle() { handle_paths "$1" "gradle" "재생성" -- \
  "$HOME/.gradle/caches" "$HOME/.gradle/daemon" "$HOME/.gradle/wrapper/dists" "$HOME/.gradle/native"; }

do_bun()    { handle_paths "$1" "bun" "재다운로드" -- "$HOME/.bun/install/cache"; }

do_cargo()  { handle_paths "$1" "cargo" "재다운로드" -- \
  "$HOME/.cargo/registry/cache" "$HOME/.cargo/registry/src" "$HOME/.cargo/git/checkouts" "$HOME/.cargo/git/db"; }

do_xcode()  { handle_paths "$1" "xcode" "재생성" -- "$HOME/Library/Developer/Xcode/DerivedData"; }

do_playwright() { handle_paths "$1" "playwright" "재다운로드(무거움)" -- \
  "$HOME/Library/Caches/ms-playwright" "$HOME/Library/Caches/ms-playwright-go"; }

# ── 추가 카테고리 (경로형) ──
do_maven()     { handle_paths "$1" "maven" "재다운로드" -- "$HOME/.m2/repository"; }
do_cocoapods() { handle_paths "$1" "cocoapods" "재다운로드" -- "$HOME/Library/Caches/CocoaPods"; }
do_swiftpm()   { handle_paths "$1" "swiftpm" "재생성" -- "$HOME/Library/Caches/org.swift.swiftpm" "$HOME/Library/org.swift.swiftpm"; }
do_composer()  { handle_paths "$1" "composer" "재다운로드" -- "$HOME/Library/Caches/composer" "$HOME/.composer/cache"; }
do_deno()      { handle_paths "$1" "deno" "재다운로드" -- "$HOME/Library/Caches/deno"; }
do_pub()       { handle_paths "$1" "pub" "재다운로드" -- "$HOME/.pub-cache"; }
# colima: Library/Caches/colima(다운로드 캐시)만. ~/.colima/_disks(컨테이너 데이터)는 절대 제외.
do_colima()    { handle_paths "$1" "colima" "재다운로드" -- "$HOME/Library/Caches/colima"; }
do_huggingface() { handle_paths "$1" "huggingface" "재다운로드(무거움)" -- "$HOME/.cache/huggingface"; }

# ── IDE 캐시 (인덱스/코드 캐시만 — 설정·확장·워크스페이스 상태는 건드리지 않음) ──
do_jetbrains()     { handle_paths "$1" "jetbrains" "재생성" -- "$HOME/Library/Caches/JetBrains"; }
do_androidstudio() { handle_paths "$1" "androidstudio" "재생성" -- $HOME/Library/Caches/Google/AndroidStudio* "$HOME/.android/cache"; }
do_zed()           { handle_paths "$1" "zed" "재생성" -- "$HOME/Library/Caches/dev.zed.Zed"; }
do_vscode() { handle_paths "$1" "vscode" "재생성" -- \
  "$HOME/Library/Application Support/Code/Cache" "$HOME/Library/Application Support/Code/CachedData" \
  "$HOME/Library/Application Support/Code/Code Cache" "$HOME/Library/Application Support/Code/GPUCache" \
  "$HOME/Library/Application Support/Code/CachedExtensionVSIXs"; }
do_cursor() { handle_paths "$1" "cursor" "재생성" -- \
  "$HOME/Library/Application Support/Cursor/Cache" "$HOME/Library/Application Support/Cursor/CachedData" \
  "$HOME/Library/Application Support/Cursor/Code Cache" "$HOME/Library/Application Support/Cursor/GPUCache" \
  "$HOME/Library/Application Support/Cursor/CachedExtensionVSIXs"; }
# CodeMate(자체 IDE): 로그/캐시만 — 설치 본체(lib·bin)·DB·인증·설정은 절대 건드리지 않음
do_codemate() { handle_paths "$1" "codemate" "재생성" -- \
  "$HOME/.codemate/userdata/logs" "$HOME/.codemate/caches" "$HOME/.codemate/daemon.log"; }

# uv(Python, Astral): 네이티브 cache clean 우선. ~/.local/share/uv(설치된 파이썬·툴)은 제외
do_uv() {
  local p1="$HOME/.cache/uv" p2="$HOME/Library/Caches/uv"
  case "$1" in
    size) paths_size_kb "$p1" "$p2" ;;
    dry)  printf "  %-16s %6s  ${C_DIM}%s${C_0}\n" "uv" "$(human "$(paths_size_kb "$p1" "$p2")")" "재다운로드" ;;
    json) emit_json uv "$(paths_size_kb "$p1" "$p2")" "재다운로드" ;;
    paths) printf '%s\n%s\n' "$p1" "$p2" ;;
    clean)
      if command -v uv >/dev/null 2>&1; then uv cache clean >/dev/null 2>&1 || { wipe "$p1"; wipe "$p2"; }
      else wipe "$p1"; wipe "$p2"; fi ;;
  esac
}

# codex 런타임 캐시(재다운로드 큼) — ~/.codex(세션·설정)은 절대 건드리지 않음
do_codex() { handle_paths "$1" "codex" "재다운로드(무거움)" -- "$HOME/.cache/codex-runtimes"; }

# ── 추가 카테고리 (v0.1.5) ──
# Electron: 바이너리 다운로드 캐시 + electron-builder 배포도구 캐시. 다음 빌드 때 재다운로드.
do_electron()  { handle_paths "$1" "electron" "재다운로드" -- \
  "$HOME/Library/Caches/electron" "$HOME/Library/Caches/electron-builder"; }
# ccache/sccache: 컴파일 캐시 — 지워도 재빌드만 느려짐(네트워크 불필요).
do_ccache()    { handle_paths "$1" "ccache" "재생성" -- \
  "$HOME/.ccache" "$HOME/Library/Caches/ccache" "$HOME/Library/Caches/Mozilla.sccache"; }
# RubyGems/bundler: 다운로드한 .gem 원본 캐시만(설치된 gem 본체는 건드리지 않음).
do_gem()       { handle_paths "$1" "gem" "재다운로드" -- $HOME/.gem/ruby/*/cache "$HOME/.bundle/cache"; }
do_poetry()    { handle_paths "$1" "poetry" "재다운로드" -- "$HOME/Library/Caches/pypoetry"; }
do_carthage()  { handle_paths "$1" "carthage" "재다운로드" -- "$HOME/Library/Caches/org.carthage.CarthageKit"; }
do_puppeteer() { handle_paths "$1" "puppeteer" "재다운로드(무거움)" -- "$HOME/.cache/puppeteer"; }
do_cypress()   { handle_paths "$1" "cypress" "재다운로드(무거움)" -- "$HOME/Library/Caches/Cypress"; }
# 로컬 LLM 모델 — 개당 수GB~수십GB. 모델만, 설정/대화기록은 제외.
do_ollama()    { handle_paths "$1" "ollama" "재다운로드(무거움)" -- "$HOME/.ollama/models"; }
do_lmstudio()  { handle_paths "$1" "lmstudio" "재다운로드(무거움)" -- \
  "$HOME/.lmstudio/models" "$HOME/.cache/lm-studio"; }
# iOS/watchOS/tvOS DeviceSupport: 기기 심볼 — 기기 재연결 시 Xcode 가 재생성(기기 필요).
do_xcode-devsupport() { handle_paths "$1" "xcode-devsupport" "재생성" -- \
  "$HOME/Library/Developer/Xcode/iOS DeviceSupport" \
  "$HOME/Library/Developer/Xcode/watchOS DeviceSupport" \
  "$HOME/Library/Developer/Xcode/tvOS DeviceSupport"; }
# Bazel: 출력 베이스(홈 밖 /private/var/tmp 포함) — 지우면 전체 재빌드.
do_bazel()     { handle_paths "$1" "bazel" "재생성" -- \
  "$HOME/.cache/bazel" "/private/var/tmp/_bazel_$USER"; }
# conda/mamba 패키지 캐시: 네이티브 conda clean 우선, 없으면 pkgs 디렉터리 정리.
do_conda() {
  local dirs=("$HOME/miniconda3/pkgs" "$HOME/miniforge3/pkgs" "$HOME/anaconda3/pkgs" "$HOME/.conda/pkgs")
  case "$1" in
    size) paths_size_kb "${dirs[@]}" ;;
    dry)  printf "  %-16s %6s  ${C_DIM}%s${C_0}\n" "conda" "$(human "$(paths_size_kb "${dirs[@]}")")" "재다운로드(무거움)" ;;
    json) emit_json conda "$(paths_size_kb "${dirs[@]}")" "재다운로드(무거움)" ;;
    paths) printf '%s\n' "${dirs[@]}" ;;
    clean)
      if command -v conda >/dev/null 2>&1; then conda clean -ay >/dev/null 2>&1 || wipe "${dirs[@]}"
      else wipe "${dirs[@]}"; fi ;;
  esac
}
# 구버전 시뮬레이터 런타임: 버전당 5~8GB. **사용 불가(Unusable/Unknown) 상태만** 삭제 —
# 현재 쓰는 런타임은 절대 건드리지 않는다. 파싱 실패하면 아무것도 안 함(안전한 no-op).
do_simruntime() {
  case "$1" in
    size) echo 0 ;;   # 런타임 용량은 simctl 로 정확 측정이 어려워 0 표기(정리는 동작)
    dry)  printf "  %-16s %6s  ${C_DIM}%s${C_0}\n" "simruntime" "  ~?" "사용불가 시뮬 런타임" ;;
    json) emit_json simruntime 0 "사용불가 시뮬 런타임" ;;
    paths) : ;;
    clean)
      if command -v xcrun >/dev/null 2>&1; then
        xcrun simctl runtime list 2>/dev/null \
          | awk '/\(Unusable|\(Unknown/ {for(i=1;i<=NF;i++) if ($i ~ /^\([0-9A-Fa-f-]{36}\)$/) {gsub(/[()]/,"",$i); print $i}}' \
          | while read -r rid; do
              [ -n "$rid" ] && xcrun simctl runtime delete "$rid" >/dev/null 2>&1 || true
            done
      fi ;;
  esac
}

# go: 네이티브 go clean 우선 (modcache는 읽기전용이라 rm 전 chmod 필요)
do_go() {
  local p=("$HOME/Library/Caches/go-build" "$HOME/go/pkg/mod")
  case "$1" in
    size) paths_size_kb "${p[@]}" ;;
    dry)  printf "  %-16s %6s  ${C_DIM}%s${C_0}\n" "go" "$(human "$(paths_size_kb "${p[@]}")")" "재다운로드" ;;
    json) emit_json go "$(paths_size_kb "${p[@]}")" "재다운로드" ;;
    paths) printf '%s\n' "${p[@]}" ;;
    clean) command -v go >/dev/null 2>&1 && go clean -cache -modcache >/dev/null 2>&1 \
           || { chmod -R u+w "$HOME/go/pkg/mod" 2>/dev/null; wipe "${p[@]}"; } ;;
  esac
}

# nuget: dotnet 네이티브 우선
do_nuget() {
  local dir="$HOME/.nuget/packages"
  case "$1" in
    size) paths_size_kb "$dir" ;;
    dry)  printf "  %-16s %6s  ${C_DIM}%s${C_0}\n" "nuget" "$(human "$(paths_size_kb "$dir")")" "재다운로드" ;;
    json) emit_json nuget "$(paths_size_kb "$dir")" "재다운로드" ;;
    paths) printf '%s\n' "$dir" ;;
    clean) command -v dotnet >/dev/null 2>&1 && dotnet nuget locals all --clear >/dev/null 2>&1 || wipe "$dir" ;;
  esac
}

# xcode-sim: 사용 불가 시뮬레이터 삭제 (용량 측정 불가 → 0)
do_xcode-sim() {
  case "$1" in
    size) echo 0 ;;
    dry)  printf "  %-16s %6s  ${C_DIM}%s${C_0}\n" "xcode-sim" "  ~?" "사용불가 시뮬레이터" ;;
    json) emit_json xcode-sim 0 "사용불가 시뮬레이터" ;;
    paths) : ;;
    clean) command -v xcrun >/dev/null 2>&1 && xcrun simctl delete unavailable >/dev/null 2>&1 || true ;;
  esac
}

# npm: 네이티브 cleanup 우선
do_npm() {
  local p1="$HOME/.npm/_cacache" p2="$HOME/.npm/_npx"
  case "$1" in
    size) paths_size_kb "$p1" "$p2" ;;
    dry)  printf "  %-16s %6s  ${C_DIM}%s${C_0}\n" "npm" "$(human "$(paths_size_kb "$p1" "$p2")")" "재다운로드" ;;
    json) emit_json npm "$(paths_size_kb "$p1" "$p2")" "재다운로드" ;;
    paths) printf '%s\n%s\n' "$p1" "$p2" ;;
    clean)
      if command -v npm >/dev/null 2>&1; then npm cache clean --force >/dev/null 2>&1 || wipe "$p1"
      else wipe "$p1"; fi
